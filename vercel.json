{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/AI_HANDOFF_CURRENT.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/games-development.html",
      "destination": "/interactive-projects/",
      "permanent": true
    },
    {
      "source": "/games.html",
      "destination": "/interactive-projects/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
